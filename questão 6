fun main() {
    val matriz = arrayOf(
        intArrayOf(1, 2, 3, 4),
        intArrayOf(5, 6, 7, 8),
        intArrayOf(9, 10, 11, 12)
    )

    for (i in matriz.indices) {
        var somaLinha = 0
        for (j in matriz[i].indices) {
            somaLinha += matriz[i][j]
        }
        println("Soma da linha ${i + 1}: $somaLinha")
    }
}
